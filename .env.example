# =============================================================================
# Railway Production — set these in Railway dashboard (never commit secrets)
# =============================================================================
# APP_KEY                  — run `php artisan key:generate`, paste result
# APP_URL                  — your production domain
# APP_ENV=production
# APP_DEBUG=false
# SESSION_DRIVER=redis      # Offloads sessions from Postgres
# SESSION_SECURE_COOKIE=true
# SESSION_ENCRYPT=true
# SESSION_HTTP_ONLY=true
# SESSION_SAME_SITE=lax
# CACHE_STORE=redis         # Offloads cache from Postgres
# QUEUE_CONNECTION=redis    # Offloads queue from Postgres
# REDIS_HOST=…              — Railway Redis plugin host
# REDIS_PORT=6379
# REDIS_PASSWORD=…
# DB_*                      — Railway PostgreSQL service credentials
# PHP_CLI_SERVER_WORKERS=4  — only if using `php artisan serve`
# FILESYSTEM_DISK=s3        — for production file storage
# AWS_*                     — if using S3

APP_NAME=Jawla
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=jawla
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Dev: file is faster than database for local cache
# Production: set CACHE_STORE=redis (with REDIS_* vars)
CACHE_STORE=file

# Redis — uncomment in production (requires phpredis extension + Railway Redis)
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
# MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Sentry (Phase 14) — set DSN to enable error tracking
# SENTRY_LARAVEL_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.2

# Backup (Phase 14) — set S3 or local disk for db snapshot storage
# BACKUP_DISK=s3
# BACKUP_NOTIFICATIONS_MAIL=

VITE_APP_NAME="${APP_NAME}"
