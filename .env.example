# =============================================================================
# Railway Production — set these in Railway dashboard (never commit secrets)
# =============================================================================
# APP_KEY                  — run `php artisan key:generate`, paste result
# APP_URL                  — your production domain
# APP_ENV=production
# APP_DEBUG=false
# SESSION_DRIVER=redis      # Offloads sessions from Postgres
# SESSION_CONNECTION=default
# SESSION_STORE=redis
# SESSION_SECURE_COOKIE=true
# SESSION_ENCRYPT=true
# SESSION_HTTP_ONLY=true
# SESSION_SAME_SITE=lax
# CACHE_STORE=redis         # Offloads cache from Postgres
# QUEUE_CONNECTION=redis    # Offloads queue from Postgres
# REDIS_URL=...             # Railway Redis URL (preferred)
# REDIS_HOST=…              — Railway Redis plugin host
# REDIS_PORT=6379
# REDIS_PASSWORD=…
# DB_*                      — Railway PostgreSQL service credentials
# PHP_CLI_SERVER_WORKERS=4  — only if using `php artisan serve`
# FILESYSTEM_DISK=s3        — for production file storage
# AWS_*                     — if using S3

APP_NAME=Jawla
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Application mode: 'production' or 'demo' (disables certain features in demo)
# JAWLA_MODE=production

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=jawla
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Sanctum API token expiration (minutes). Default: 1440 (24 hours).
# Set to null for non-expiring tokens (not recommended for production).
SANCTUM_TOKEN_EXPIRATION=1440

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Production rep photos require durable private object storage.
PHOTO_DISK=public
QUEUE_CONNECTION=database

# Dev: file is faster than database for local cache
# Production: set CACHE_STORE=redis (with REDIS_* vars)
CACHE_STORE=file

# Redis — uncomment in production (requires phpredis extension + Railway Redis)
# REDIS_CLIENT=phpredis
# REDIS_URL=
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# Trusted Proxies — comma-separated list of proxy IPs to trust.
# Default '*' trusts all (fine for development/containers).
# In production, restrict to your load balancer/proxy IPs.
# TRUSTED_PROXIES=*

MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
# MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Sentry (Phase 14) — set DSN to enable error tracking
# SENTRY_LARAVEL_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.2
# SENTRY_RELEASE=
# SENTRY_ENVIRONMENT=${APP_ENV}

# Sanctum — set stateful domains for SPA auth
# SANCTUM_STATEFUL_DOMAINS=your-domain.com

# Backup (Phase 14) — set S3 or local disk for db snapshot storage
# BACKUP_DISK=s3
# BACKUP_NOTIFICATIONS_MAIL=

# Data retention (days). Location pings are purged periodically to save space.
# JAWLA_RETENTION_LOCATION_PINGS=90
# JAWLA_RETENTION_ACTIVITY_LOGS=365
# JAWLA_RETENTION_SESSIONS=30

# Stock import settings
# JAWLA_STOCK_IMPORT_PREVIEW_TTL=15
# JAWLA_STOCK_IMPORT_LARGE_VARIANCE=1000.000

# Bootstrap admin password (used by artisan jawla:bootstrap-production)
# JAWLA_BOOTSTRAP_ADMIN_PASSWORD=

# Optional push gateway used by the self-hosted installation.
JAWLA_PUSH_GATEWAY_URL=
JAWLA_PUSH_GATEWAY_TOKEN=

# Installation-bound application license. Store the vendor public key with
# escaped newlines (\n); the signed license document is uploaded in /admin.
JAWLA_LICENSE_PUBLIC_KEY=
JAWLA_INSTALLATION_ID=

# ETA e-invoicing (Egyptian Tax Authority) — GO-LIVE GATE.
# Leave disabled for demo/UAT. To go live, register the taxpayer with ETA,
# obtain OAuth credentials + a signing certificate, then set:
# ETA_ENABLED=true
# ETA_ENVIRONMENT=preprod            # preprod (sandbox) | production
# ETA_TAXPAYER_RIN=
# ETA_CLIENT_ID=
# ETA_CLIENT_SECRET=
# ETA_API_BASE_URL=
# ETA_ID_BASE_URL=
# ETA_DOCUMENT_TYPE_VERSION=1
# ETA_TAXPAYER_ACTIVITY_CODE=47910

VITE_APP_NAME="${APP_NAME}"
