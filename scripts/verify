#!/usr/bin/env bash
set -euo pipefail

echo "=== Jawla verification ==="

echo "1/5 Lint..."
vendor/bin/pint --test

echo "2/5 Typecheck..."
vendor/bin/phpstan analyse --level=3 --memory-limit=2G --no-progress

echo "3/5 Tests..."
php artisan test --testsuite=Unit,Feature 2>&1

echo "4/5 Build..."
npm run build

echo "5/5 Audit..."
composer audit
npm audit --audit-level=high --omit=dev

echo "=== All checks passed ==="
