{
  "ci": {
    "collect": {
      "url": ["http://127.0.0.1:8000"],
      "startServerCommand": "php artisan serve --port=8000",
      "numberOfRuns": 3
    },
    "assert": {
      "preset": "lighthouse:recommended",
      "assertions": {
        "categories:performance": ["error", { "maxScore": 0.8 }],
        "categories:accessibility": ["error", { "minScore": 0.8 }],
        "categories:best-practices": ["error", { "minScore": 0.8 }],
        "categories:seo": ["error", { "minScore": 0.8 }],
        "usability:first-contentful-paint": ["error", { "max": 1800 }],
        "usability:largest-contentful-paint": ["error", { "max": 2500 }],
        "usability:cumulative-layout-shift": ["error", { "max": 0.1 }],
        "usability:total-blocking-time": ["error", { "max": 100 }],
        "usability:interactive": ["error", { "max": 3000 }]
      }
    }
  }
}
