includes:
  - vendor/larastan/larastan/extension.neon
parameters:
  level: 6
  paths:
    - app
  tmpDir: '%currentWorkingDirectory%/storage/app/phpstan-tmp'
  memoryLimit: 512M
  # Cache directory for PHPStan — must be writable on Windows.
  # Default uses sys_get_temp_dir()/phpstan which on Windows may resolve
  # to C:\WINDOWS\phpstan and fail with permission denied.
